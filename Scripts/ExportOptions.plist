<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  REM Image Producer's own export file. Never mark a build internal only.
  REM His rule 2026-11-02: "you shouldnt flag internal testers only" · "its not your place to decide".
  REM Apple fixes the internal-only mark at upload; a build marked internal can never go external later.
  REM manageAppVersionAndBuildNumber OFF: the build number must name its commit (post-commit hook).
-->
<plist version="1.0"><dict>
<key>method</key><string>app-store-connect</string>
<key>destination</key><string>upload</string>
<key>teamID</key><string>3X3F6UJ44H</string>
<key>signingStyle</key><string>automatic</string>
<key>testFlightInternalTestingOnly</key><false/>
<key>manageAppVersionAndBuildNumber</key><false/>
</dict></plist>
